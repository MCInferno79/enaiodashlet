{
  "manifest_version": 3,
  "name": "PageDeck",
  "version": "2.0.0",
  "description": "Verbindet frei belegbare Stream-Deck-Tasten mit Aktionen auf Ihren Webseiten.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "PageDeck – Einstellungen und Status",
    "default_icon": "icon.png"
  },
  "options_page": "workspaces.html",
  "incognito": "not_allowed",
  "icons": {
    "128": "icon.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:29381 ws://127.0.0.1:29381"
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
