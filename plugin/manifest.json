{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "de.heki.autoprofile",
  "Name": "PageDeck",
  "Author": "PageDeck",
  "Version": "2.0.0.0",
  "Description": "Universelle Webseiten-Aktionen und dynamische Tasten für Microsoft Edge.",
  "Category": "PageDeck",
  "CategoryIcon": "assets/category",
  "Icon": "assets/plugin",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24"
  },
  "Actions": [
    {
      "UUID": "de.heki.autoprofile.control",
      "Name": "Verbindung / Pause",
      "Tooltip": "PageDeck koppeln und die Automatik pausieren.",
      "Icon": "assets/action",
      "PropertyInspectorPath": "ui/index.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "assets/key",
          "TitleAlignment": "middle",
          "FontSize": 12
        }
      ]
    },
    {
      "UUID": "de.heki.autoprofile.web",
      "Name": "Webseiten-Taste",
      "Tooltip": "Führt die für diese Tastennummer und Webseite hinterlegte Aktion aus.",
      "Icon": "assets/action",
      "PropertyInspectorPath": "ui/index.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "assets/key",
          "TitleAlignment": "middle",
          "FontSize": 10
        }
      ]
    }
  ],
  "Profiles": []
}
