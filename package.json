{
  "name": "heki-stream-deck-auto-profile-switcher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Lokaler URL-basierter Stream-Deck-Profilwechsler für Microsoft Edge",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "validate": "streamdeck validate dist/de.heki.autoprofile.sdPlugin --no-update-check",
    "test:browser": "node tests/browser.e2e.mjs",
    "test:ui": "node tests/ui.e2e.mjs",
    "release": "node scripts/release.mjs",
    "verify": "npm run check && npm run build && npm test && npm run validate"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.2"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.2",
    "@types/chrome": "0.3.5",
    "@types/node": "22.18.6",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "fflate": "0.8.2",
    "marked": "16.3.0",
    "playwright-core": "1.64.0",
    "typescript": "5.9.3",
    "ws": "8.19.0"
  }
}
